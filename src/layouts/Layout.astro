---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  image?: string;
  canonical?: string;
  jsonLd?: unknown;
}
const {
  title,
  description = "Agenda du tango à Nice et sur la Côte d'Azur",
  lang = 'fr',
  image,
  canonical,
  jsonLd,
} = Astro.props;

// Canonical from Astro.site, not Astro.url: the built pages are served from
// one origin and any preview deployment must still point at the real one.
const canonicalUrl = canonical ?? new URL(Astro.url.pathname, Astro.site).href;
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_FR" />
    {image && <meta property="og:image" content={new URL(image, Astro.site)} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}
  </head>
  <body>
    <header>
      <a href="/" class="logo">nissartango</a>
      <a href="/en/" class="lang">EN</a>
    </header>
    <main><slot /></main>
    <footer>
      <p>nissartango — Nice, Côte d'Azur</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1a1a1a;
    --muted: #6b6b6b;
    --accent: #a01b2e;
    --line: #e5e2dd;
    --bg: #fbfaf8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .logo { font-weight: 700; font-size: 1.1rem; text-decoration: none; color: var(--ink); letter-spacing: -0.01em; }
  .lang { font-size: 0.85rem; text-decoration: none; color: var(--muted); }
  main { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  footer { border-top: 1px solid var(--line); padding: 2rem 1.5rem; color: var(--muted); font-size: 0.85rem; }
</style>