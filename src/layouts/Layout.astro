---
interface Props {
  title: string;
  description?: string;
  lang?: string;
  /**
   * The social preview card. Defaults to the site-wide one, so EVERY page has
   * an og:image -- until 2026-10-03 not one page did, because this prop existed
   * and nothing ever passed it. A link shared to WhatsApp or Facebook rendered
   * as a bare line of text, which for an agenda whose events circulate by
   * message is most of how anyone would have arrived.
   */
  image?: { src: string; width?: number; height?: number; alt?: string };
  canonical?: string;
  jsonLd?: unknown;
}
const {
  title,
  description = "Agenda du tango et des danses sociales à Nice et sur la Côte d'Azur",
  lang = 'fr',
  image,
  canonical,
  jsonLd,
} = Astro.props;

// Canonical from Astro.site, not Astro.url: the built pages are served from
// one origin and any preview deployment must still point at the real one.
// Trailing slash, always: that is the form the server returns 200 for, and a
// canonical pointing at a URL that redirects is a canonical that is wrong.
const path = Astro.url.pathname.endsWith('/') || /\.[a-z0-9]+$/i.test(Astro.url.pathname)
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = canonical ?? new URL(path, Astro.site).href;

// public/og-default.jpg, generated by scripts/make-og-default.mjs and committed.
// 1200x630 is the size every platform states for a large summary card.
const og = image ?? {
  src: '/og-default.jpg',
  width: 1200,
  height: 630,
  alt: "nissartango — agenda du tango et des danses sociales à Nice et sur la Côte d'Azur",
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* favicon.ico is found at the root without a tag; the SVG is not. NOTE:
        both files are still Astro's own logo from `npm create astro`. */}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Nissartango" />
    {/* ABSOLUTE, always: a relative og:image is ignored by most crawlers, and
        the one that matters here is whatever WhatsApp uses. */}
    <meta property="og:image" content={new URL(og.src, Astro.site).href} />
    {og.width && <meta property="og:image:width" content={String(og.width)} />}
    {og.height && <meta property="og:image:height" content={String(og.height)} />}
    {og.alt && <meta property="og:image:alt" content={og.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}
  </head>
  <body>
    <header>
      <a href="/" class="logo">nissartango</a>
    </header>
    <main><slot /></main>
    <footer>
      <p>nissartango — Nice, Côte d'Azur</p>
    </footer>
  </body>
</html>

<style is:global>
  :root {
    --ink: #1a1a1a;
    --muted: #6b6b6b;
    --accent: #a01b2e;
    --line: #e5e2dd;
    --bg: #fbfaf8;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    background: var(--bg);
    color: var(--ink);
    font-family: ui-sans-serif, system-ui, -apple-system, sans-serif;
    line-height: 1.6;
  }
  header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--line);
  }
  .logo { font-weight: 700; font-size: 1.1rem; text-decoration: none; color: var(--ink); letter-spacing: -0.01em; }
  main { max-width: 46rem; margin: 0 auto; padding: 2.5rem 1.5rem 4rem; }
  footer { border-top: 1px solid var(--line); padding: 2rem 1.5rem; color: var(--muted); font-size: 0.85rem; }
</style>