---
import '../styles/fonts.css';
import '../styles/tokens.css';
import '../styles/base.css';
import { NAV, isCurrent } from '../data/nav';
/* The wordmark is INLINED, not an <img>, for one reason: its two ink paths
   are fill="currentColor" while the ART keeps its literal orange, so one
   file follows light and dark with no second asset and no JavaScript. An
   <img> cannot inherit colour. design/brand/ is the single definition --
   scripts/make-favicon.mjs and make-og-default.mjs read it too. */
import wordmark from '../../design/brand/logo-wordmark.svg?raw';
interface Props {
  title: string;
  description?: string;
  lang?: string;
  /**
   * The social preview card. Defaults to the site-wide one, so EVERY page has
   * an og:image -- until 2026-10-03 not one page did, because this prop existed
   * and nothing ever passed it. A link shared to WhatsApp or Facebook rendered
   * as a bare line of text, which for an agenda whose events circulate by
   * message is most of how anyone would have arrived.
   */
  image?: { src: string; width?: number; height?: number; alt?: string };
  canonical?: string;
  jsonLd?: unknown;
}
const {
  title,
  description = "Agenda du tango et des danses sociales à Nice et sur la Côte d'Azur",
  lang = 'fr',
  image,
  canonical,
  jsonLd,
} = Astro.props;

// Canonical from Astro.site, not Astro.url: the built pages are served from
// one origin and any preview deployment must still point at the real one.
// Trailing slash, always: that is the form the server returns 200 for, and a
// canonical pointing at a URL that redirects is a canonical that is wrong.
const path = Astro.url.pathname.endsWith('/') || /\.[a-z0-9]+$/i.test(Astro.url.pathname)
  ? Astro.url.pathname
  : `${Astro.url.pathname}/`;
const canonicalUrl = canonical ?? new URL(path, Astro.site).href;

// public/og-default.jpg, generated by scripts/make-og-default.mjs and committed.
// 1200x630 is the size every platform states for a large summary card.
const og = image ?? {
  src: '/og-default.jpg',
  width: 1200,
  height: 630,
  alt: "nissartango — agenda du tango et des danses sociales à Nice et sur la Côte d'Azur",
};
---
<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* favicon.ico is found at the root without a tag; the other two are not.
        All three come from scripts/make-favicon.mjs. */}
    {/* Only the 500 — it is the system's only weight and every page sets it,
        so it is on the critical path. The 600 exists for <strong> in an
        organizer's prose and has its own @font-face, so a page without bold
        never fetches it. `crossorigin` is required on a font preload even
        same-origin; without it the browser fetches the file TWICE. */}
    <link rel="preload" href="/fonts/inter-latin-500-normal.woff2"
          as="font" type="font/woff2" crossorigin />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:site_name" content="Nissartango" />
    {/* ABSOLUTE, always: a relative og:image is ignored by most crawlers, and
        the one that matters here is whatever WhatsApp uses. */}
    <meta property="og:image" content={new URL(og.src, Astro.site).href} />
    {og.width && <meta property="og:image:width" content={String(og.width)} />}
    {og.height && <meta property="og:image:height" content={String(og.height)} />}
    {og.alt && <meta property="og:image:alt" content={og.alt} />}
    <meta name="twitter:card" content="summary_large_image" />
    {jsonLd && (
      <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />
    )}
  </head>
  <body>
    <header>
      <a href="/" class="logo" aria-label="nissARTango — accueil" set:html={wordmark} />
      {/* Text only, no icons and no background pills, per the reference. Two
          entries wrap rather than collapse at narrow widths: a disclosure menu
          needs JavaScript, and verify-build check 3 fails the build on any. */}
      <nav aria-label="Navigation principale">
        <ul>
          {NAV.map((item) => (
            <li>
              <a href={item.href}
                 aria-current={isCurrent(item.href, path) ? 'page' : undefined}>{item.label}</a>
            </li>
          ))}
        </ul>
      </nav>
    </header>
    <main><slot /></main>
    <footer>
      <p class="what">
        nissARTango — l'agenda du tango et des danses sociales à Nice et sur la
        Côte d'Azur. Cours, practicas, milongas, stages, démonstrations et
        festivals.
      </p>
      <p class="invite">
        {/* Explicit space: Astro trims the whitespace at the end of a text
            node that precedes an element, so the newline here does NOT
            collapse to one and the sentence rendered as "événement ?Proposez". */}
        Vous organisez un événement ?{' '}
        <a href="https://editor.nissartango.fr/aide/">Proposez-le à l'agenda</a> —
        c'est gratuit, et vous gardez la main sur votre fiche.
      </p>
    </footer>
  </body>
</html>
