---
import { getCollection, render } from 'astro:content';
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import { getImage } from 'astro:assets';
import {
  loadAgenda, socialLinks, contactLinks, formatSummary, formatProse, priceSummary, paymentSummary,
  spanLabel, dateRangeLabel,
  fmtFull, fmtDay, isoWithOffset, toRow,
} from '../../lib/content';
import { expand, nextDate, RECURRENCE_LABELS } from '../../lib/occurrences.js';
import { mapsUrl, mapsQuery } from '../../lib/map.js';

// ONE page per series, never one per occurrence. A weekly practica is a single
// thing with a single URL; thin per-date duplicates would compete with each
// other in search results and multiply for no reader benefit.
export async function getStaticPaths() {
  const events = await getCollection('events');
  return events.map((entry) => ({ params: { slug: entry.data.slug }, props: { entry } }));
}

const { entry } = Astro.props;
const e = toRow(entry);
const { Content } = await render(entry);

// WHERE IT IS, ON A MAP. A plain <a>, because this site ships no client-side
// JavaScript at all (verify-build check 3 fails the build on any <script> tag
// that is not ld+json) -- so an onclick was never an option, and is not needed.
//
// A CAPITALISED VARIABLE AS THE TAG is Astro's way of choosing an element at
// build time: <Place> renders as <a> when there is somewhere to point and as
// <span> when there is not, so the three address lines are written once rather
// than once per branch. A lowercase name would be emitted as a literal
// <place> element.
//
// rel="noopener noreferrer": noopener because target=_blank hands the opened
// page a handle on this one, and noreferrer because Google does not need to be
// told which event page sent the visitor. Neither costs anything here.
const mapHref = mapsUrl(e);
const Place = mapHref ? 'a' : 'span';
const placeAttrs = mapHref
  ? {
      href: mapHref,
      class: 'map',
      target: '_blank',
      rel: 'noopener noreferrer',
      // Said out loud, because a new tab that opens unannounced is
      // disorienting for a screen-reader user and the underline alone does
      // not say where the link goes.
      'aria-label': `Ouvrir ${mapsQuery(e)} dans Google Maps — nouvel onglet`,
    }
  : {};

const { organizers, exceptionsByEvent } = await loadAgenda();
const organizer = organizers.get(e.organizer_id);
const exceptions = exceptionsByEvent.get(e.id) ?? [];

const tz = e.timezone || 'Europe/Paris';
const now = new Date();
const recurrenceLabel = RECURRENCE_LABELS[e.recurrence];
const price = priceSummary(e);
const payment = paymentSummary(e);
const cancelled = Boolean(e.cancelled_at);

// One expansion feeds both the visible list and the markup. Google's rule for
// structured data is that it must describe what the page actually shows, so
// the two are derived from the same array rather than computed twice.
const allOccurrences = expand(e, exceptions, { now });
const futureOccurrences = allOccurrences.filter((o) => o.start >= now);

// Every upcoming date, cancellations included so a reader can see which week
// is off. No cap of its own: the agenda and this page both list what expand()
// returns inside its 6-month horizon, so the two cannot disagree about which
// dates exist. A cap here was an arbitrary 8, which meant the agenda listed
// dates through late November that the series page stopped short of -- and,
// because the markup follows this list, dates the markup never mentioned.
//
// THE TEST IS "MORE THAN ONE DATE", NOT "IS A SERIES". It read
// `e.recurrence === 'none' ? [] : futureOccurrences` until extra_dates existed
// (20261001150000), and then a three-day workshop -- recurrence `none`, three
// occurrences -- rendered as a single date while the agenda listed three.
// verify-build.mjs caught it: "the agenda lists ... on 2026-10-03, but that
// page's JSON-LD does not mention it". `recurrenceLabel` is kept in the test so
// a series with one remaining date behaves exactly as it did before.
const manyDates = Boolean(recurrenceLabel) || allOccurrences.length > 1;
const dates = manyDates ? futureOccurrences : [];

// A multi-day one-off -- a weekend workshop, a three-day festival -- is NOT a
// series, and this page should say so the way the agenda already does.
//
// Until 2026-10-12 the detail row was labelled "Prochaine date" and printed
// the first date, two lines above a "Prochaines dates" list beginning with
// that same date. On a two-day workshop the 17th appeared twice within four
// lines, which reads as a mistake rather than a summary. Worse, it DISAGREED
// with the agenda, which calls the same event "du samedi 17 au dimanche 18
// octobre 2026" -- one object described two ways by two pages of one site.
//
// A SERIES keeps "Prochaine date": the next one is the useful fact, and a
// range running to the end of a weekly series would say nothing. The range is
// taken from `dates`, the same array the list below renders, so the row and
// the list cannot drift apart -- which is the mistake being fixed here.
const isSeries = Boolean(recurrenceLabel);
const isRun = !isSeries && dates.length > 1;
const dateLabel = isSeries ? 'Prochaine date' : isRun ? 'Dates' : 'Date';

// Has this already happened? Nothing still to come, which is the same test
// loadAgenda() uses to decide the archive -- so a page that says "passé"
// is exactly a page listed there, and neither can contradict the other.
//
// Worth saying out loud on the page: most arrivals at a past event come from
// a search result or a shared link, months later, and the page otherwise
// reads as an invitation. Cancelled events already say Annulé and are not
// also labelled past -- one banner, the more specific one.
const past = !cancelled && futureOccurrences.length === 0;

const when = nextDate(e, exceptions, { now });

// Images are downloaded into src/assets/events by scripts/fetch-content.mjs,
// so Astro can optimise them and Cloudflare can serve them. The glob is how a
// build-time-known filename reaches Vite's asset pipeline.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../../assets/events/*.{jpeg,jpg,png,webp,avif}', { eager: true });
const image = e.image_file
  ? images[`../../assets/events/${e.image_file}`]?.default
  : undefined;

// Trailing slash: the page is served at /evenements/<slug>/ and the no-slash
// form 301s to it. A canonical, a sitemap entry or a JSON-LD url pointing at
// the redirecting form declares one URL and serves another.
const canonical = new URL(`/evenements/${e.slug}/`, Astro.site).href;
const description =
  `${formatProse(e) || 'Événement'} le ${fmtFull(when, tz)} à ` +
  `${e.location_name ? e.location_name + ', ' : ''}${e.city}.`;

// --- schema.org ------------------------------------------------------------
// A recurring series gets ONE Event item PER DATE, not a single item with an
// eventSchedule: Google does not consume eventSchedule/exceptDate, and it asks
// that the markup describe what the page visibly says. So the items are
// exactly the dates rendered under "Prochaines dates", each with its own
// startDate and its own eventStatus -- which is how a cancelled 22 October is
// announced as cancelled instead of disappearing behind a Scheduled 3
// September.
//
// startDate carries the real offset (+02:00 in summer, +01:00 in winter);
// a floating local time or a UTC instant both mislead aggregators.
const ldOccurrences = dates.length
  ? dates
  : [futureOccurrences[0] ?? allOccurrences[0]].filter(Boolean);

// Each date is addressable: the list items below carry the matching id, so a
// result that deep-links to one date lands on the line that describes it.
const urlFor = (o: any) =>
  ldOccurrences.length > 1 ? `${canonical}#date-${o.dateKey}` : canonical;

// No offers on a date that is off: eventStatus says Cancelled, and an Offer
// with availability InStock alongside it is a contradiction aggregators can
// and do act on.
function offersFor(o: any) {
  const off = cancelled || o.cancelled;
  if (off || (e.price_full == null && e.price_member == null)) return undefined;
  const url = e.signup_url ?? urlFor(o);
  return [
    e.price_full != null && {
      '@type': 'Offer', price: String(e.price_full), priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock', url,
    },
    e.price_member != null && {
      '@type': 'Offer', name: 'Tarif adhérent/réduit',
      price: String(e.price_member), priceCurrency: 'EUR',
      availability: 'https://schema.org/InStock', url,
    },
  ].filter(Boolean);
}

function eventStatusFor(o: any) {
  if (cancelled || o.cancelled) return 'https://schema.org/EventCancelled';
  if (o.moved) return 'https://schema.org/EventRescheduled';
  return 'https://schema.org/EventScheduled';
}

const place = {
  '@type': 'Place',
  name: e.location_name ?? e.city,
  address: {
    '@type': 'PostalAddress',
    ...(e.location_address ? { streetAddress: e.location_address } : {}),
    addressLocality: e.city,
    ...(e.location_postal_code ? { postalCode: e.location_postal_code } : {}),
    addressCountry: 'FR',
  },
};

function eventNode(o: any) {
  const url = urlFor(o);
  const offers = offersFor(o);
  return {
    '@type': 'Event',
    '@id': url,
    name: e.title,
    url,
    startDate: isoWithOffset(o.start, tz),
    ...(e.duration_minutes
      ? { endDate: isoWithOffset(new Date(o.start.getTime() + e.duration_minutes * 60000), tz) }
      : {}),
    eventStatus: eventStatusFor(o),
    // A moved date keeps a pointer to the slot it left, so an aggregator that
    // already indexed the old one can retire it rather than show both.
    ...(o.moved && o.previousStart
      ? { previousStartDate: isoWithOffset(o.previousStart, tz) }
      : {}),
    eventAttendanceMode: 'https://schema.org/OfflineEventAttendanceMode',
    ...(e.body ? { description: e.body.replace(/\s+/g, ' ').trim().slice(0, 300) } : {}),
    location: place,
    ...(organizer ? {
      organizer: {
        '@type': 'Organization',
        name: organizer.name,
        ...(organizer.website ? { url: organizer.website } : {}),
      },
    } : {}),
    ...(e.teachers.length ? { performer: e.teachers.map((n: string) => ({ '@type': 'Person', name: n })) } : {}),
    ...(offers ? { offers } : {}),
    ...(image ? { image: [new URL(image.src, Astro.site).href] } : {}),
  };
}

// The flyer as a social card, when there is one.
//
// RESIZED TO 1200 WIDE AND RE-ENCODED AS JPEG rather than reusing the <Image>
// output: that is a hashed WebP with a srcset, which is right for the page and
// wrong for a crawler -- several still do not take WebP, and none take a
// srcset. The height is computed from the source's own aspect ratio, because a
// flyer is usually portrait and forcing 1200x630 would crop the poster to a
// band across its middle. Platforms letterbox what they are given; they cannot
// un-crop it.
const ogImage = image
  ? {
      src: (await getImage({ src: image, width: 1200, format: 'jpeg' })).src,
      width: 1200,
      height: Math.round(image.height * (1200 / image.width)),
      alt: `Affiche — ${e.title}`,
    }
  : undefined;

const nodes = ldOccurrences.map(eventNode);
// @graph rather than a bare array: one script, one @context, and every node
// keeps its own @id. A bare array is legal too; this is easier to extend.
const jsonLd = nodes.length === 1
  ? { '@context': 'https://schema.org', ...nodes[0] }
  : { '@context': 'https://schema.org', '@graph': nodes };
---

<Layout
  title={`${e.title} — Nissartango`}
  description={description}
  canonical={canonical}
  jsonLd={jsonLd}
  image={ogImage}
>
  <a href={past || cancelled ? '/archives/' : '/'} class="back">
    {past || cancelled ? '← Archives' : '← Agenda'}
  </a>

  <span class="type">{formatSummary(e)}</span>

  {/* THE DATE ABOVE THE TITLE, from 2026-10-23, and at every width rather
      than only on a phone -- one structure beats two.

      It was the first row of the <dl> below, which on a portrait flyer put it
      a full screen down: the page opened on a poster and the reader scrolled
      past it to learn when the thing happens. Kicker, date, headline is the
      ordinary editorial stack and it says the two facts that decide whether
      to read on before the title has to carry them alone.

      THE LABEL IS STILL SAID, clipped exactly as the <dt>s are. "Prochaine
      date" is not furniture on a weekly series -- it is the difference
      between the next one and the only one -- and leaving the dl must not
      cost it. */}
  <p class="when">
    <span class="label">{dateLabel}</span>
    {/* The END TIME, which until 2026-10-02 appeared nowhere on this page.
        duration_minutes had one use in the whole site -- schema.org's
        endDate -- so the markup told aggregators how long an event ran and
        the page told a reader nothing. No duration still renders "à 18:00",
        because for a multi-day workshop whose days differ in length that is
        the honest answer rather than a missing one. */}
    {isRun
      ? dateRangeLabel(dates[0].start, dates[dates.length - 1].start, tz, { year: false })
      : fmtDay(when, tz)} {spanLabel(when, e.duration_minutes, tz)}
    {recurrenceLabel && <span class="recur">{recurrenceLabel}</span>}
  </p>

  <h1>{e.title}</h1>

  {cancelled && (
    <p class="banner">
      Annulé{e.cancellation_note ? ` — ${e.cancellation_note}` : ''}
    </p>
  )}

  {past && (
    <p class="banner past">
      Événement passé. Il est conservé pour mémoire ;
      voir l'<a href="/">agenda</a> pour ce qui vient.
    </p>
  )}

  {image && (
    <Image src={image} alt={e.title} widths={[400, 800, 1200]}
           sizes="(max-width: 45rem) 100vw, 45rem" class="flyer" />
  )}

  <dl class="details">
    <dt>Lieu</dt>
    <dd>
      {/* A LINK ONLY WHEN IT WOULD LAND SOMEWHERE. mapsUrl() returns null for
          an event naming no venue and no street: `city` defaults to 'Nice' in
          the schema, so a query built from it alone resolves to the middle of
          town -- a link that looks helpful and is not. The lines render
          identically either way; only the wrapper changes. */}
      <Place {...placeAttrs}>
        {e.location_name}{e.location_name && <br />}
        {e.location_address}{e.location_address && <br />}
        {/* ONE expression, with the space INSIDE it. Written as
            `{postcode} {city}`, the separating space is its own text node
            between two expressions, and the build's HTML compression drops it:
            every event carrying a postcode rendered "06300Nice". Found
            2026-10-21 by reading the built markup of the fixture; it had been
            true of every event page with a postcode. Joining first puts the
            space inside a single text node, where nothing can collapse it --
            and it also drops the leading space when there is no postcode. */}
        {[e.location_postal_code, e.city].filter(Boolean).join(' ')}
      </Place>
    </dd>

    {e.teachers.length > 0 && (<><dt>Avec</dt><dd>{e.teachers.join(', ')}</dd></>)}

    {(e.price_full != null || e.price_member != null || e.price_note || payment) && (
      <>
        <dt>Tarif</dt>
        {/* priceSummary carries the note now, so this no longer appends it
            separately -- doing both would print it twice. */}
        <dd>
          {price}
          {/* Only when the organizer said. An empty array renders nothing
              rather than implying cash. */}
          {payment && <span class="note">Paiement : {payment}</span>}
        </dd>
      </>
    )}

    <dt>Organisé par</dt>
    <dd>
      {organizer?.name ?? '—'}
      {organizer && socialLinks(organizer).length > 0 && (
        <span class="social">
          {socialLinks(organizer).map((l) => (
            <a href={l.href} rel="noopener">{l.label}</a>
          ))}
        </span>
      )}
      {/* Contact details the organizer asked to publish. Rendered rather than
          merely stored: a sanctioned field that never appears is not a
          sanctioned field, it is image_path. */}
      {organizer && contactLinks(organizer).length > 0 && (
        <span class="contact">
          {contactLinks(organizer).map((l) => (
            <a href={l.href}>{l.label}</a>
          ))}
        </span>
      )}
    </dd>
  </dl>

  {/* THE DESCRIPTION COMES BEFORE THE DATES, 2026-10-23. It was the other way
      round, which asked a reader to work through a list of occurrences before
      finding out what the event IS -- and on a weekly series inside the
      six-month horizon that list is long. What it is, then when it happens
      again. */}
  <div class="prose"><Content /></div>

  {dates.length > 0 && (
    <section class="dates">
      <h2>Prochaines dates</h2>
      <ul>
        {dates.map((o) => (
          <li id={`date-${o.dateKey}`} class={o.cancelled ? 'off' : undefined}>
            {/* o.start is the MOVED instant for a moved occurrence, so the
                span is that date's real time without special-casing. The list
                said "— déplacé" and never said what it was moved to. */}
            {fmtDay(o.start, tz)} {spanLabel(o.start, e.duration_minutes, tz)}
            {o.cancelled && <> — annulé{o.note ? ` (${o.note})` : ''}</>}
            {o.moved && <> — déplacé{o.note ? ` (${o.note})` : ''}</>}
          </li>
        ))}
      </ul>
    </section>
  )}

  {e.signup_url && !cancelled && (
    <a class="cta" href={e.signup_url} rel="noopener">S'inscrire</a>
  )}
</Layout>

<style>
  .back { font-size: var(--t-body); color: var(--ink); text-decoration: none; }
  /* --accent-text, not --accent: the raw brand orange is 3.79:1 on paper. */
  .type {
    display: block; margin-top: var(--space-32); font-size: var(--t-body);
    text-transform: uppercase; letter-spacing: var(--tr-kicker);
    color: var(--accent-text);
  }
  h1 { font-size: var(--t-h1); margin: var(--space-4) 0 var(--space-20); }

  /* Both banners occupy the same place and only one ever shows. Neither is
     red any more: colour is rationed, and a cancellation is marked by a rule
     in the brand orange rather than by tinting the text. The orange is a
     GRAPHIC here (3.79:1 clears the 3:1 bar for a boundary); the words stay
     ink so they clear AA. */
  .banner {
    background: var(--linen); color: var(--ink);
    border-left: 3px solid var(--accent);
    padding: var(--space-12) var(--space-16);
    border-radius: var(--radius-sharp);
    margin: 0 0 var(--space-32);
  }
  /* Past is not an error: a quieter rule and quieter text. */
  .banner.past { border-left-color: var(--rule-strong); color: var(--ink); }
  .banner.past a { color: inherit; }

  /* TWO CAPS, because a flyer can be wrong in two directions.
   *
   * It was `width: 100%` of the shell, which at a 1200px viewport rendered
   * 1137x1516: wider than the prose it introduces and half again taller than
   * the window, so the page opened on an image and nothing else, with the
   * date, the venue and the price at y=1809.
   *
   * THE WIDTH CAP WAS ALREADY DECLARED, in the `sizes` attribute, and the CSS
   * had simply never agreed with it. `sizes` promised the browser the image
   * would never exceed 46rem, so the browser fetched a 736px file and the CSS
   * then stretched it across 1137px -- a 1.54x upscale, soft on every screen.
   * Capping the width is what makes that attribute true again; it is not a new
   * decision, it is the one the markup already recorded.
   *
   * The width cap is --width-prose rather than a literal 46rem. That was
   * chosen so the flyer sat on exactly the measure of the text below it --
   * a relationship rather than a number. THAT IS NO LONGER TRUE: the
   * description was uncapped on 2026-10-23 and the flyer stayed. What keeps
   * it here is the `sizes` attribute, which promises 46rem and would be a
   * lie at any wider box; --width-prose happens to be 45rem and honours it.
   * If --width-prose ever moves, check `sizes` rather than assuming.
   *
   * THE HEIGHT CAP IS THE NEW ONE. A portrait flyer -- and they are portrait,
   * the fixture's are 900x1200 because real ones are -- hits the width cap
   * without ever hitting a sensible height, so width alone does not fix the
   * wall. 60vh keeps the details inside the first screen on the laptop and
   * desktop heights this is read at, which is the point: the flyer is the
   * poster, not the page.
   *
   * width/height auto let the two caps fight it out while the aspect ratio
   * holds. For a 3:4 flyer the height cap binds; for a landscape one the width
   * cap does. */
  .flyer {
    display: block;
    width: auto; height: auto;
    max-width: min(100%, var(--width-prose));
    max-height: 60vh;
    border-radius: var(--radius-media); margin-bottom: var(--space-32);
  }
  /* NO LABEL COLUMN AND NO RULES, from 2026-10-14. This was a two-column
     definition list bracketed by hairlines: "Lieu" beside the venue, "Tarif"
     beside the price, "Organisé par" beside the organizer. Every one of those
     labels names something the value already announces -- an address is
     obviously an address and "10 €" is obviously a price -- so they were a
     column of furniture holding the real content at arm's length.

     THE LABELS ARE STILL IN THE MARKUP and only leave the screen. A <dl> whose
     <dt>s were deleted is invalid, and more to the point a screen reader
     reading "La Casita del Tango" with nothing before it loses the one thing
     the label was genuinely carrying. So they are clipped, not removed: the
     page reads the same to software and is quieter to look at.

     That includes "Avec", which was NOT on the list of four to remove and goes
     anyway, because one visible label among five invisible ones reads like an
     oversight. Teachers are the one value that is not self-evident -- if that
     ever matters, fold the word into the value ("Avec Mauro et Sol") rather
     than bringing the column back for a single row. */
  .details {
    display: grid; grid-template-columns: 1fr; gap: var(--space-12);
    margin: 0 0 var(--space-32); padding: 0;
    font-size: var(--t-body);
  }
  .details dt, .when .label {
    position: absolute; width: 1px; height: 1px;
    padding: 0; margin: -1px; overflow: hidden;
    clip-path: inset(50%); white-space: nowrap; border: 0;
  }
  /* The values are set like a row title on the home page -- the same display
     face, weight and step of the scale -- because that is what they are: the
     answer to when, where and how much, which the agenda already sets this way. */
  .details dd, .when {
    margin: 0;
    font-family: var(--font-display); font-weight: var(--weight-medium);
    font-size: var(--t-h2); line-height: var(--lh-h2); letter-spacing: var(--tr-h2);
  }
  /* The date left the list but not its typography: it is the same answer to
     the same kind of question, and setting it apart up here would make it a
     third voice between the kicker and the headline. */
  .when { margin: var(--space-4) 0 var(--space-8); }
  /* THE ADDRESS KEEPS ITS INK. It is set at --t-h2 in the display face, so the
     site's default link colour -- accent, full underline -- would turn the
     loudest block on the page into the loudest link on the page, and it is an
     address, not a call to action. What it gets instead is an affordance: a
     hairline underline at the rule colour, offset enough not to collide with
     the descenders of a street name. Hover and keyboard focus bring the accent
     in, which is where a link may say what it is.

     :focus-visible and not :focus, so a mouse click does not leave the ring
     behind on a block this large. */
  .map {
    color: inherit;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-decoration-color: var(--rule);
    text-underline-offset: 4px;
  }
  .map:hover, .map:focus-visible {
    color: var(--accent-text);
    text-decoration-color: currentColor;
  }

  /* Secondary lines INSIDE a value stay body type, or the whole block arrives
     at one size and the hierarchy the step up was meant to create disappears. */
  .recur, .note, .social, .contact {
    font-family: var(--font-body); font-weight: var(--weight);
    letter-spacing: normal;
  }
  .recur, .note { display: block; color: var(--ink); font-size: var(--t-body); }
  .social { display: block; margin-top: var(--space-4); font-size: var(--t-body); }
  .social a { margin-right: var(--space-12); }
  .contact { display: block; margin-top: var(--space-4); font-size: var(--t-body); }
  .contact a { margin-right: var(--space-12); }
  /* Touch targets; see the note in base.css. These are the only ones that also
     needed WIDTH -- "Site" is 31px of lettering, so vertical padding alone
     would have left a 31x44 target. 8px either side takes it to 47, and the
     12px margin still sits OUTSIDE that, so two hit areas never touch. */
  @media (max-width: 40rem) {
    .social a, .contact a {
      display: inline-block;
      padding: 10px var(--space-8);
      margin: -10px var(--space-12) -10px calc(var(--space-8) * -1);
    }
  }

  .dates { margin: var(--space-64) 0; }
  .dates h2 {
    font-size: var(--t-section); line-height: var(--lh-section);
    letter-spacing: var(--tr-section);
    font-weight: var(--weight-heavy); color: var(--ink);
    margin: 0 0 var(--space-32);
  }
  .dates ul { list-style: none; padding: 0; margin: 0; font-size: var(--t-body); }
  .dates li { padding: var(--space-4) 0; }
  .dates li.off { color: var(--ink); text-decoration: line-through; }

  /* THE DESCRIPTION RUNS THE FULL COLUMN HERE, 2026-10-23. base.css caps
     .prose at --width-prose; this page uncaps it, so the text lines up with
     the venue, the price and the dates list above and below it instead of
     stopping at 62% of their width and leaving a ragged right edge down the
     middle of the page.

     MEASURED BEFORE AND AFTER, because the cap's own comment in tokens.css
     is wrong about what it buys: it says 45rem "keeps roughly the 65"
     characters, and at --t-h2 (28px) the longest paragraph in the fixture
     actually ran 50 per line. Uncapped at a 1200px viewport it runs ~80 --
     the long end of comfortable, and what the reference this design follows
     does on its own pages, which cap prose at nothing at all.

     The FLYER keeps --width-prose and does not follow. Its cap is not really
     about the prose: `sizes` promises the browser the image will never exceed
     46rem, so a wider box would stretch a 736px file across 1152 and go soft.
     The comment there claims the two are tied so they cannot drift; they are
     untied as of today, and the flyer's number is now its own. */
  .prose { margin-bottom: var(--space-32); max-width: none; }

  /* Pill, per the reference's radius contrast -- and an INK label, not a
     cream one: cream on this orange is 3.79:1 and fails, ink is 4.77:1 and
     passes. The reference reaches the same conclusion about its own pill. */
  /* The phone override that used to live here is gone with the label column.
     It stacked the 8rem/1fr grid at 375px, where the label left only 199px for
     the value and a long price note wrapped to three cramped lines. The list is
     one column at every width now, so there is nothing left to collapse. */

  .cta {
    display: inline-block; background: var(--accent); color: var(--ink);
    padding: var(--space-12) var(--space-24); border-radius: var(--radius-pill);
    text-decoration: none; font-size: var(--t-body);
  }
  /* ON A PHONE, ONE SIZE FOR EVERYTHING BUT THE TITLE -- AND IT IS --t-meta.
   *
   * At 375px this page carried three sizes above the body: the values at 24px
   * in the display face, the prose at 24, and "Prochaines dates" at 31 -- a
   * hierarchy drawn for a 1200px column, where a step up has room to read as
   * a step up. On a 343px measure it reads as four competing voices.
   *
   * So the scale collapses to ONE size here and the h1 keeps the only step.
   * The headings do not stop being headings: "Prochaines dates" holds
   * --weight-heavy and the kicker holds its case and its colour, which is
   * enough to mark a boundary when there is no room to mark it by size.
   *
   * THE SIZE IS --t-meta, NOT --t-body, and that is a measured choice rather
   * than a nudge. 20px over a 343px measure is about 34 characters to the
   * line; 16px is about 45, the bottom of the range a paragraph wants and the
   * first point on this scale that reaches it. There is nothing between the
   * two -- the public ramp steps 13 -> 16 -> 20 on purpose -- so the honest
   * options were 20 or 16, and 20 was the one already on screen.
   *
   * --lh-meta (1.5) comes with it, against --lh-body (1.6). 32px line boxes
   * become 24px: the leading was set for a long measure, and a short one
   * needs less of it to keep the eye on the right line.
   *
   * THE H1 IS UNTOUCHED -- 31px at --lh-h1 -- so the one step that survives
   * gets wider rather than narrower, which is the point of collapsing the
   * rest.
   *
   * THE DISPLAY FACE GOES WITH THE SIZE. Space Grotesk at --tr-h2 is tracked
   * -0.02em because large type has air to buy back; set this small it is
   * simply tight, and an address is the one block on the page a reader parses
   * character by character. The values become body type -- IBM Plex, normal
   * tracking -- like everything around them.
   *
   * THIS BLOCK IS LAST IN THE FILE ON PURPOSE. A media query carries no
   * specificity of its own, so it ties with every plain class rule here and
   * source order decides. While it sat higher up, .cta -- declared below it
   * at the same specificity -- won, and the one button on the page stayed
   * 20px while everything around it was 16. Measured, not reasoned about.
   * Anything added after this block will beat it the same way. */
  @media (max-width: 40rem) {
    .back, .type, .when, .details dd, .recur, .note, .social, .contact,
    .dates h2, .dates ul, .prose, .cta {
      font-size: var(--t-meta); line-height: var(--lh-meta);
    }
    .when, .details dd {
      font-family: var(--font-body); font-weight: var(--weight);
      letter-spacing: normal;
    }
    .dates h2 { letter-spacing: normal; }
    /* :global, because these come out of <Content /> -- an organizer's own
       markdown -- and never carry this component's scope attribute. The
       inherited size above reaches a <p> and cannot reach these, which
       base.css sets explicitly at --t-h2. They stay headings by weight:
       the browser's bold matches IBM Plex's 600, a face it ships. */
    .prose :global(h2), .prose :global(h3) {
      font-size: var(--t-meta); line-height: var(--lh-meta);
    }
  }
</style>