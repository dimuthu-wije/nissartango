---
/**
 * Événements passés.
 *
 * WHY THIS PAGE EXISTS. Every approved event already had a page, and four of
 * the five on this site had nothing linking to them — the agenda shows only
 * what is still to come, and there was no second place to look. A page that
 * exists, is in the sitemap, and is reachable from nowhere is a page a reader
 * can only arrive at from Google, and a page the site itself does not admit to
 * having.
 *
 * WHAT COUNTS AS PAST is not decided here. `loadAgenda()` returns `archived`
 * as exactly the events that produced no listed occurrence, so the agenda and
 * this page are complementary by construction: no event can fall between them
 * and none can appear in both. If that ever stops being true it is a bug in
 * one computation rather than a disagreement between two.
 *
 * That includes wholly-cancelled series, which have a date in the future and
 * nothing still to come. They belong here rather than nowhere, marked Annulé —
 * somebody linked to that milonga before it was called off.
 *
 * GROUPED BY YEAR, newest first. At ~200 events a year this page will want
 * splitting per year well before it wants pagination; the grouping is already
 * the seam to split on.
 */
import Layout from '../../layouts/Layout.astro';
import { loadAgenda, formatSummary, fmtFull } from '../../lib/content';

const { archived, organizers } = await loadAgenda();

// The year an event ENDED, which for a series is its last night, not its
// first. A weekly practica that ran from November into January belongs under
// the year it finished — that is the year a reader remembers it by.
const byYear = new Map<number, typeof archived>();
for (const row of archived) {
  const year = Number(
    new Intl.DateTimeFormat('fr-FR', {
      year: 'numeric', timeZone: row.event.timezone || 'Europe/Paris',
    }).format(row.ended),
  );
  byYear.set(year, [...(byYear.get(year) ?? []), row]);
}
const years = [...byYear.keys()].sort((a, b) => b - a);

const title = 'Archives — événements passés | Nissartango';
---

<Layout title={title} description="Les événements passés de l'agenda des danses de Nice et de la Côte d'Azur.">
  <h1>Archives</h1>
  <p class="intro">
    Les événements qui ont eu lieu. Pour ce qui vient, voir l'<a href="/">agenda</a>.
  </p>

  {archived.length === 0 && (
    <p class="empty">Rien encore aux archives — tout ce qui est publié est à venir.</p>
  )}

  {years.map((year) => (
    <section class="year">
      <h2>{year}</h2>
      <ul class="events">
        {byYear.get(year)!.map(({ event: e, ended, shown, last }) => {
          const organizer = organizers.get(e.organizer_id);
          const series = e.recurrence && e.recurrence !== 'none';
          const started = new Date(e.starts_at);
          return (
            <li data-event={e.slug} data-ended={ended.toISOString().slice(0, 10)}
                class={e.cancelled_at ? 'cancelled' : undefined}>
              <div class="when">
                {/* A completed series gets its span, because "when was that?"
                    about one is a range. A single date, and a series cancelled
                    before it finished, get the one date that means anything. */}
                <span class="date">{fmtFull(shown, e.timezone)}</span>
                {series && !e.cancelled_at && started < last && (
                  <span class="since">depuis le {fmtFull(started, e.timezone)}</span>
                )}
                {series && e.cancelled_at && (
                  <span class="since">série annulée</span>
                )}
              </div>
              <div class="what">
                <span class="type">{formatSummary(e)}</span>
                <h3><a href={`/evenements/${e.slug}/`}>{e.title}</a></h3>
                <p class="meta">
                  {e.location_name}{e.location_name && ', '}{e.city}
                  {organizer && <> · {organizer.name}</>}
                </p>
                {e.cancelled_at && (
                  <p class="off">Annulé{e.cancellation_note ? ` — ${e.cancellation_note}` : ''}</p>
                )}
              </div>
            </li>
          );
        })}
      </ul>
    </section>
  ))}
</Layout>

<style>
  /* No top margin: main's own padding already opens the page, and the two
     together left 84px of dead space above the title on a phone. */
  h1 { font-size: var(--text-head); margin: 0 0 var(--space-4); }
  .intro { color: var(--muted); margin: 0 0 var(--space-32); }
  .empty { color: var(--muted); }
  .year { margin: 0 0 var(--space-48); }
  /* Same treatment as the agenda's section labels, deliberately. */
  .year h2 {
    font-size: var(--text-label); text-transform: uppercase;
    letter-spacing: var(--track-label); color: var(--muted);
    margin: 0 0 var(--space-4);
  }
  .events { list-style: none; padding: 0; margin: 0; }
  /* 14rem because the longest date French can produce -- "dimanche 28
     septembre 2026" -- measures 219px (13.69rem) at --text-body in this
     stack. Measured in the browser against the real font, not estimated;
     at 10rem the archive's dates wrapped mid-date.

     Stage 4 should ask whether the LISTING needs the year at all. An agenda
     showing the next few weeks mostly does not, and dropping it would take
     this column to about 11rem and buy back 48px on every row. */
  .events li {
    display: grid; grid-template-columns: 14rem 1fr; gap: var(--space-16);
    padding: var(--space-16) 0; border-top: 1px solid var(--rule);
  }
  .when { display: flex; flex-direction: column; }
  .date { font-size: var(--text-body); }
  .since { font-size: var(--text-body); color: var(--muted); }
  .what h3 { margin: var(--space-4) 0 var(--space-4); font-size: var(--text-row); }
  .what h3 a { color: inherit; text-decoration: none; }
  .what h3 a:hover { text-decoration: underline; }
  /* Muted, not the accent the agenda uses: a past event should not shout. */
  .type {
    font-size: var(--text-label); text-transform: uppercase;
    letter-spacing: var(--track-label); color: var(--muted);
  }
  .meta { margin: 0; color: var(--muted); font-size: var(--text-body); }
  /* Was var(--bad), which was never defined anywhere -- so this declaration
     was invalid and the text fell back to inherited ink. */
  .off { margin: var(--space-4) 0 0; font-size: var(--text-body); color: var(--muted); }
  .cancelled .what h3 { text-decoration: line-through; }

  @media (max-width: 34rem) {
    .events li { grid-template-columns: 1fr; gap: var(--space-4); }
    .when { flex-direction: row; gap: var(--space-8); align-items: baseline; }
  }
</style>
