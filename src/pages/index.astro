---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import {
  loadAgenda, formatSummary, priceSummary, fmtFull, fmtDay, fmtTime, rhythmLabel,
} from '../lib/content';
import { runs } from '../lib/occurrences.js';
import { dateRangeLabel } from '../lib/span.js';
import { mapsUrl, mapsQuery } from '../lib/map.js';

/**
 * A ROLLING WINDOW, THEN EVERYTHING ELSE.
 *
 * This was "À venir" and "Rendez-vous réguliers" until 2026-10-12 -- news and
 * furniture, with regulars collapsed to one row each because a weekly milonga
 * had otherwise filled eight consecutive identical rows.
 *
 * The window solves that in a way a reader recognises. A weekly event appears
 * once or twice because that is how often it happens in seven days, not
 * because it was filed under a heading about regularity -- and somebody
 * opening an agenda is asking what is on, not which things recur.
 *
 * ROLLING, NOT THE CALENDAR WEEK. "Cette semaine" read on a Sunday evening
 * means today only, so the top of the page would empty out every seventh day,
 * forever.
 *
 * `later` is ONE CARD PER EVENT and carries everything the window does not,
 * including a biweekly or monthly series whose next date is further out. That
 * is not tidiness: verify-build check 8b fails the build when an event page is
 * reachable from neither listing, and with "Rendez-vous réguliers" deleted
 * those two series would have been reachable from nowhere.
 */
// Flyers, resolved the same way the event page resolves them: fetch-content
// downloads each referenced object into src/assets/events/ and records the
// flattened filename in image_file, and the glob is how a build-time import
// reaches a directory whose contents it cannot know in advance.
const images = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/events/*.{jpeg,jpg,png,webp,avif}', { eager: true });

const { soon, later, standing, organizers, archived } = await loadAgenda();
const nothingAtAll = soon.length === 0 && later.length === 0 && standing.length === 0;
---

<Layout title="Nissartango — Agenda du tango et des danses à Nice">
  <p class="intro">Cours, practicas, milongas, stages et soirées à Nice et sur la Côte d'Azur — tango, et les autres danses sociales.</p>

  {/* THE TITLE SITS ON THE FIRST SECTION, 2026-10-23. It heads the listing
      rather than the document: the nav already says Agenda at the top of
      every page, so a title up there named the page twice in two lines.

      It stays OUTSIDE the <section>. Inside, an h1 would read as the heading
      of "the next seven days" rather than of the page, and the second
      section's h2 would then sit under a heading that does not contain it.
      Outside and immediately before, the outline is h1 Agenda > h2 window >
      h2 Évènements, which is what the page means. */}
  <div class="page-title">
    <h1>Agenda</h1>
    {/* The window LEAVES the <section> to sit beside the title. Its rank in
        the document is unchanged -- h1 Agenda, h2 Les 7 prochains jours,
        then the rows' h3s, then h2 Évènements -- and rank in document order
        is what a screen reader navigates by. The HTML outline algorithm,
        which is the only thing <section> containment would have fed, was
        never implemented by any browser or AT.

        Guarded, because with nothing at all to list there is no window to
        name and the line would label an empty page. */}
    {!nothingAtAll && <h2 class="window">Les 7 prochains jours</h2>}
  </div>

  {nothingAtAll && (
    <p class="empty">
      Aucun événement à venir pour le moment.
      {archived.length > 0 && <> Les précédents sont <a href="/archives/">aux archives</a>.</>}
    </p>
  )}

  {!nothingAtAll && (
    <section class="block">
      {soon.length === 0 ? (
        <p class="empty">Rien dans les sept prochains jours — voir les évènements ci-dessous.</p>
      ) : (
        <ul class="events">
          {runs(soon).map((row) => {
            const e = row.event;
            const o = row.first;
            const organizer = organizers.get(e.organizer_id);
            const price = priceSummary(e);
            // Same refusal as the event page: no link when the query would be
            // a bare city. See src/lib/map.js.
            const mapHref = mapsUrl(e);
            const Place = mapHref ? 'a' : 'span';
            const placeAttrs = mapHref
              ? { href: mapHref, class: 'map', target: '_blank', rel: 'noopener noreferrer',
                  'aria-label': `Ouvrir ${mapsQuery(e)} dans Google Maps — nouvel onglet` }
              : { class: 'map-off' };
            // ONE ROW PER EVENT, not per date. data-date carries the FIRST
            // date only; verify-build check 9 requires every agenda date to
            // exist on the event's own page and explicitly allows that page
            // to list more, which is the direction a range collapses in.
            return (
              <li class={row.cancelled ? 'cancelled' : undefined}
                  data-event={e.slug} data-date={o.dateKey}>
                <div class="when">
                  <span class="date">{row.multi
                    ? dateRangeLabel(row.first.start, row.last.start, e.timezone, { year: false })
                    : fmtDay(o.start, e.timezone)}</span>
                  <span class="time">{fmtTime(o.start, e.timezone)}</span>
                </div>
                <div class="what">
                  <span class="type">{formatSummary(e)}</span>
                  <h3><a href={`/evenements/${e.slug}/`}>{e.title}</a></h3>
                  {organizer && <p class="meta">{organizer.name}</p>}
                  {/* A STAMP, not a coloured sentence. The accent is already
                      spent on the eyebrow directly above, and a second warm
                      colour here would muddy against it -- so this is marked
                      by case and tracking instead, which is the system's own
                      "structure, not colour". */}
                  {row.cancelled && (
                    <p class="status">
                      <span class="tag">Annulé</span>
                      {o.note && <> {o.note}</>}
                    </p>
                  )}
                  {!row.cancelled && row.moved && (
                    <p class="status">
                      <span class="tag">Séance déplacée</span>
                      {o.note && <> {o.note}</>}
                    </p>
                  )}
                  {/* Dates inside a range that do not behave. fmtDay has no
                      year, which is right here and only here: the range on
                      this same row already carries it. */}
                  {!row.cancelled && row.multi && row.offDates.length > 0 && (
                    <p class="status">
                      <span class="tag">{row.offDates[0].cancelled ? 'Annulé' : 'Déplacé'}</span>
                      {' le '}{row.offDates.map((x, i) => (
                        <>{i > 0 && ', '}{fmtDay(x.start, e.timezone)}</>
                      ))}
                    </p>
                  )}
                </div>
                  {/* The NAME of the place when it has one, and the whole
                      address when it does not. A venue name is what somebody
                      recognises -- "La Casita" means more locally than the
                      street it is on -- and the address is only worth the room
                      when there is no name to recognise. */}
                  <div class="where">
                    {/* THE WRAPPER TAKES THE LAYOUT, not .where, because it is
                        now sometimes an <a> and sometimes a <span> and the
                        .venue spans must stay its direct children either way.
                        Above 62rem they are flex items and stack; below, they
                        are inline text so the address wraps like a sentence.
                        Both rules therefore name .map AND .map-off. */}
                    <Place {...placeAttrs}>
                      {e.location_name
                        ? <span class="venue">{e.location_name}</span>
                        : [e.location_address, e.location_postal_code, e.city]
                            .filter(Boolean)
                            .map((part, i) => <span class="venue">{i > 0 && ' '}{part}</span>)}
                    </Place>
                  </div>
              </li>
            );
          })}
        </ul>
      )}
    </section>
  )}

  {later.length > 0 && (
    <section class="block" id="evenements">
      <h2>Évènements</h2>
      <ul class="cards">
        {later.map(({ event: e, next, occurrences }) => {
          // `next` is the next date it actually HAPPENS; null only when every
          // remaining date is cancelled, which must still render. The first
          // occurrence stands in then, so the card keeps a date for
          // verify-build check 9 to check against the event's own page.
          const shown = next ?? occurrences[0];
          const rhythm = rhythmLabel(e.recurrence, shown.start, e.timezone);
          const flyer = e.image_file
            ? images[`../assets/events/${e.image_file}`]?.default
            : undefined;
          const run = !rhythm && occurrences.length > 1;
          const cardHref = mapsUrl(e);
          return (
            <li class={flyer ? 'card has-flyer' : 'card'}
                data-event={e.slug} data-date={shown.dateKey}>
              <div class="card-text">
              <span class="type">{formatSummary(e)}</span>
              <h3><a href={`/evenements/${e.slug}/`}>{e.title}</a></h3>
              {/* The card says name + city, never the street: it is a
                  thumbnail, not an itinerary. The LINK still carries the full
                  address, because mapsQuery() builds from the row and not from
                  what this line happens to show -- a visitor who taps it gets
                  the street even though the card never printed it. */}
              <p class="card-where">{cardHref
                ? <a href={cardHref} class="map" target="_blank" rel="noopener noreferrer"
                     aria-label={`Ouvrir ${mapsQuery(e)} dans Google Maps — nouvel onglet`}
                  >{[e.location_name, e.city].filter(Boolean).join(', ')}</a>
                : [e.location_name, e.city].filter(Boolean).join(', ')}</p>
              <p class="card-when">
                {run
                  ? dateRangeLabel(occurrences[0].start,
                                   occurrences[occurrences.length - 1].start, e.timezone,
                                   { year: false })
                  : fmtDay(shown.start, e.timezone)}
                {', '}{fmtTime(shown.start, e.timezone)}
                {rhythm && <> · {rhythm}</>}
              </p>
              </div>
              {/* alt="" on purpose: the title sits beside it and a screen
                  reader announcing the flyer would read the event twice. */}
              {flyer && (
                <div class="card-media">
                  <Image src={flyer} alt="" widths={[220, 440, 686, 900]}
                         sizes="(max-width: 30rem) calc(100vw - 32px), (max-width: 48rem) 136px, 220px" />
                </div>
              )}
            </li>
          );
        })}
      </ul>
    </section>
  )}

    {/* ESTABLISHED regulars whose next date is past the window. Not cards, by
        choice -- a series in its fourth month is furniture and a card is a loud
        thing to spend on furniture. But verify-build check 8b fails the build
        when an event page is reachable from neither listing, so they get a line
        of links: present, reachable, quiet. Usually this renders nothing at
        all, because a weekly series always falls inside seven days. */}
    {standing.length > 0 && (
      <p class="standing">
        <span class="standing-label">Aussi, régulièrement</span>
        {standing.map(({ event: e, next, occurrences }, i) => (
          <>
            {i > 0 && <> · </>}
            <a href={`/evenements/${e.slug}/`}>{e.title}</a>
            {' '}<span class="standing-when">
              {rhythmLabel(e.recurrence, (next ?? occurrences[0]).start, e.timezone)}
            </span>
          </>
        ))}
      </p>
    )}
  {archived.length > 0 && (
    <p class="more">
      <a href="/archives/">Archives — {archived.length} événement{archived.length > 1 ? 's' : ''} passé{archived.length > 1 ? 's' : ''}</a>
    </p>
  )}
</Layout>

<style>
  /* No top margin: main's own padding already opens the page, and the two
     together left 84px of dead space above the title on a phone. */
  /* The page title outranks its sections again. They went to 44/700 and the
     h1 was still 34/500, so a section was louder than the page it sat in. */
  /* VISIBLE AGAIN, and lower down. It was clipped earlier today so the nav
     could carry the page's name; it is back because it now does a job the
     nav cannot -- it heads the listing, with the window it covers written
     under it in plain type.

     --t-masthead and not --t-section: Évènements below is a section at 48px,
     and the page title has to outrank it or the two read as peers. */
  h1 {
    font-size: var(--t-section); line-height: var(--lh-section);
    letter-spacing: var(--tr-section); font-weight: var(--weight-heavy);
    text-transform: uppercase;
    margin: 0;
  }
  /* BASELINE, not centre: two type sizes beside each other sit on a shared
     baseline or they look dropped. flex-wrap is the phone's escape -- AGENDA
     and the window together need more than 343px, so below that the line
     breaks and the window lands back underneath, which is where it was
     yesterday and still reads. The row gap is what it lands on. */
  .page-title {
    display: flex; flex-wrap: wrap; align-items: baseline;
    gap: var(--space-4) var(--space-16);
    margin: 0 0 var(--space-32);
  }
  /* The title and the line under it are ONE object, so the section's own
     96px top margin cannot come between them. Specificity settles it without
     relying on source order: `h1 + .block` is a class and an element, which
     beats the plain `.block` in both the base rule and the phone one. */
  .page-title + .block { margin-top: 0; }
  /* The lede at a section heading's size, --t-section, with that step's own
     leading and tracking. The FACE stays the body's: a heading is Space
     Grotesk here, and setting three lines of running prose in the display
     face at 48px makes a poster rather than a sentence. Size was what was
     asked for. */
  .intro {
    color: var(--ink); margin: 0 0 var(--space-32);
    font-size: var(--t-section); line-height: var(--lh-section);
    letter-spacing: var(--tr-section);
  }

  /* THE MENU, AT A HEADING'S SIZE. :global because nav lives in
     Layout.astro and carries that component's scope attribute, not this
     one's -- a plain `nav a` here would compile to a selector matching
     nothing. It is safe to leave unscoped: this stylesheet ships only with
     the page that renders it, so no other page picks the rule up. Verified
     against the built archive and event pages rather than assumed.

     Deliberately NOT in base.css. Every other page still has a visible h1 --
     38px on an event -- and a 48px nav above it would outrank the title of
     the thing you came to read. */
  :global(nav a), :global(.nav-button) {
    font-size: var(--t-section); line-height: var(--lh-section);
    letter-spacing: var(--tr-section);
  }
  .empty { color: var(--ink); }
  .more {
    margin: var(--space-32) 0 0; padding-top: var(--space-16);
    border-top: 1px solid var(--rule-strong);
  }

  /* The section heading is a LABEL, not a title: it says which kind of thing
     the rows below are. Same size and weight as "Prochaines dates" on an event
     page and the year headings in the archive, so the three read as a family.
     They now genuinely do -- before 2026-10-09 this was 0.85rem and the
     archive's was 1.1rem, so the family was asserted in a comment and nowhere
     else. */
  .block { margin: var(--space-96) 0; }
  /* Uppercase, to match AGENDA. The two are the page's only section titles
     and they are now set the same way in every respect. .window is NOT caught
     by this selector -- it left .block to sit beside the h1 -- which is the
     one thing to check if it ever reads as a heading again. */
  .block h2 {
    font-size: var(--t-section); line-height: var(--lh-section);
    letter-spacing: var(--tr-section);
    font-weight: var(--weight-heavy); color: var(--ink);
    text-transform: uppercase;
    margin: 0 0 var(--space-32);
  }
  /* "Les 7 prochains jours" in BODY TYPE -- it is no longer the heading of
     this section, it is the subtitle saying which slice of the agenda the
     rows below cover. Every heading property is undone explicitly rather
     than by omission: the family, the weight, the size, the leading and the
     tracking all come from .block h2 above and all of them would survive a
     partial override.

     ONLY THE FIRST SECTION. Évènements is still a section heading and keeps
     --t-section, which is why this is a class and not `.block:first-of-type
     h2` -- the two sections are now different kinds of thing, and the
     difference should be stated in the markup rather than inferred from
     position. */
  .window {
    font-family: var(--font-body); font-weight: var(--weight);
    font-size: var(--t-body); line-height: var(--lh-body);
    letter-spacing: normal; color: var(--ink);
    margin: 0;
  }

  .events { list-style: none; padding: 0; margin: 0; }
  /* 20rem, RE-MEASURED 2026-10-15. The comment here claimed 14rem on the
     strength of "dimanche 28 septembre 2026" measuring 219px at --text-body --
     and three separate things had since made that false: the year was dropped
     from the listing, the date moved to --t-h2 in the display face, and the
     scale went up twice. The number in the code had already drifted to 17rem
     without the comment following it.

     Measured again, against the font actually in use (28px/500 Space Grotesk):

         dimanche 28 septembre   315px = 19.69rem   <- the longest
         mercredi 24 septembre   301px
         vendredi 28 novembre    288px
         dimanche 18 octobre     273px              <- wrapped at 17rem by 1px
         lundi 2 mars            156px

     So 20rem, which clears the longest by 5px. A RANGE is a different animal
     and is left to wrap: "du mardi 20 au mercredi 21 octobre" is 456px
     (28.5rem), and no column worth giving a date will hold it. Wrapping a
     range across two lines reads correctly; wrapping "dimanche 18 / octobre"
     does not, and that is the distinction this width is for. */
  .events li {
    display: grid; grid-template-columns: 20rem 1fr 15rem; gap: var(--space-24);
    padding: var(--space-16) 0; border-top: var(--rule-weight) solid var(--rule);
  }
  /* No rule directly under a section heading: the first row's top border was
     reading as an underline on the title above it. */
  .events li:first-child { border-top: none; padding-top: 0; }
  .when { display: flex; flex-direction: column; }
  /* No text-transform. `capitalize` title-cases every word, which gave
     "Jeudi 1 Octobre" -- French writes days and months in lower case. */
  /* The date and the place are set at the TITLE's size: a row answers three
     questions of equal weight -- when, what, where -- and setting two of them
     in meta type answered one loudly and two quietly. */
  .date {
    font-size: var(--t-h2); line-height: var(--lh-h2);
    letter-spacing: var(--tr-h2); font-family: var(--font-display);
    font-weight: var(--weight-medium);
  }
  .where {
    display: flex; flex-direction: column;
    font-size: var(--t-h2); line-height: var(--lh-h2);
    letter-spacing: var(--tr-h2); font-family: var(--font-display);
    font-weight: var(--weight-medium);
  }
  /* The wrapper around the venue, whether it links or not, so the .venue
     spans keep stacking as flex items exactly as they did when .where held
     them directly. .map-off exists only to carry this layout for a row with
     nowhere to point -- it has no appearance of its own. */
  .where .map, .where .map-off { display: flex; flex-direction: column; }

  /* An address, with an affordance -- not a call to action. It is set at
     --t-h2 in the display face, so the site's accent link colour would make
     the venue the loudest thing in the row and pull the eye off the title,
     which is the link that matters here. Hairline underline at the rule
     colour; hover and keyboard focus bring the accent in.

     The decoration is declared on .venue and not on .map because above 62rem
     .map is a FLEX container, and text-decoration does not reliably reach the
     text inside flex items. Measured rather than assumed. */
  /* COLOUR ON THE ANCHOR, decoration on the text. `color: inherit` on .venue
     inherits from its parent -- which IS the anchor -- so base.css's
     `a { color: var(--accent-text) }` reached it anyway and the venue came out
     accent-orange. Measured, not reasoned: the computed colour read
     rgb(229,80,57) where this comment claimed ink. */
  .where .map, .card-where .map { color: inherit; }
  /* NO UNDERLINE AT REST, from 2026-10-23. The hairline above was there to
     say "this is a link"; asked for and taken out, so the venue now reads as
     plain ink until it is pointed at.

     THE DECLARATION IS text-decoration: none AND NOT A DELETION. base.css
     gives an <a> its colour and nothing else, so the BROWSER's default
     underline is what was underneath -- removing our rule would have left a
     full-strength black underline rather than no underline at all.

     What is left: colour and an underline on hover, and the global
     :focus-visible outline for a keyboard, which is the one affordance that
     does not depend on this rule. A mouse user now has no resting signal that
     the venue is clickable; that is the cost of the change, recorded here
     rather than discovered later. */
  .where .map, .card-where .map, .map .venue { text-decoration: none; }
  /* SCOPED TO .where AND .card-where, and that is a FIX rather than tidying.
     Astro appends its scope attribute to every compound in a selector, so
     `.where .map` ships as `.where[cid] .map[cid]` -- four in the class
     column -- while `.map:hover` ships as `.map[cid]:hover`, which is three.
     The `color: inherit` above therefore beat the hover colour and always
     had: measured 2026-10-23, the hovered anchor computed rgb(23,22,20),
     ink, where the comment above claimed the accent. Naming the parent here
     puts the two at five against four.

     It had been invisible because the resting underline was doing the work.
     With that gone, hover is the only thing a mouse has. */
  .where .map:hover, .where .map:focus-visible,
  .card-where .map:hover, .card-where .map:focus-visible {
    color: var(--accent-text);
  }
  .map:hover .venue, .map:focus-visible .venue,
  .card-where .map:hover, .card-where .map:focus-visible {
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 4px;
  }

  /* THE ROW IS ONE SIZE AT EVERY WIDTH from 2026-10-23, bar the eyebrow.
     The time, the organizer and the cancellation stamp were the three
     fields still set at --t-body while the date, the title and the place
     were at --t-h2 -- a split that made sense when the date and the place
     were the only two promoted, and stopped making sense once the answer
     was 'all of it'. --type is the one thing that steps down now, which is
     what marks where a row begins. */
  .time { color: var(--ink); font-size: var(--t-h2); line-height: var(--lh-h2); }
  /* The eyebrow is the only repeated colour on the page, and --accent-text
     rather than --accent because it is TEXT: the raw brand orange is 3.79:1
     on paper and fails AA. */
  .type {
    font-size: var(--t-kicker); line-height: var(--lh-kicker);
    text-transform: uppercase;
    letter-spacing: var(--tr-kicker); color: var(--accent-text);
  }
  h3 { font-size: var(--t-h2); line-height: var(--lh-h2); margin: var(--space-4) 0 var(--space-4); }
  h3 a { color: inherit; text-decoration: none; }
  h3 a:hover { text-decoration: underline; }
  .meta { margin: 0; color: var(--ink); font-size: var(--t-h2); line-height: var(--lh-h2); }
  /* Cancellation is structural, not chromatic: the strikethrough, the dimming
     and the stamp carry it. The red this used to be sits one hue from the
     brand orange and the two muddied each other, and the accent is already
     spent on the eyebrow two lines above.

     So the status is marked by CASE AND TRACKING, in ink, which is the same
     typographic register as the eyebrow without taking a second colour. The
     note after it stays muted: the stamp is the message, the note is detail. */
  .status {
    margin: var(--space-4) 0 0; color: var(--ink);
    font-size: var(--t-h2); line-height: var(--lh-h2);
  }
  .tag {
    text-transform: uppercase;
    letter-spacing: var(--tr-kicker);
    color: var(--ink);
  }
  li.cancelled .date, li.cancelled h3 { text-decoration: line-through; }
  li.cancelled { opacity: 0.75; }
  /* ÉVÈNEMENTS -- a grid, after the reference's own Events section: two
     columns, and type a long way up the scale. Measured on that site rather
     than guessed: its card title is 33.8px and its venue 26.6px, both weight
     500. Ours steps one down to --t-card (31px), because its columns are
     ~700px wide and these are ~460px, and a French tango title is long. This
     said --text-head-sm until 2026-10-13, which is a token that has never
     existed in this file or any other. */
  .cards {
    list-style: none; padding: 0; margin: 0;
    display: grid; grid-template-columns: repeat(2, 1fr);
    gap: var(--space-48) var(--space-32);
  }
  /* Text beside a square crop, as the reference's own Events section does it.
     The media column only exists when there is a flyer: an empty box beside
     every text-only card would be a layout pretending to content it has not
     got, and most events here will never have one. */
  /* No rules in this grid. A hairline separates rows in a LIST, where one
     thing ends and the next begins on the line below it. A card is already
     bounded by the space around it, and a border on every cell draws a table
     nobody asked for. */
  .card {
    display: grid; grid-template-columns: 1fr; gap: var(--space-16);
  }
  .card.has-flyer { grid-template-columns: 1fr minmax(0, 8.5rem); }
  .card-media img {
    display: block; width: 100%; aspect-ratio: 1;
    object-fit: cover; border-radius: var(--radius-media);
  }
  .card h3 {
    font-size: var(--t-card); line-height: var(--lh-card);
    letter-spacing: var(--tr-card);
    margin: var(--space-4) 0;
  }
  .card h3 a { color: inherit; text-decoration: none; }
  .card h3 a:hover { text-decoration: underline; }
  /* --lh-h2 (1.25) AND NOT --lh-meta (1.5), at every width. 1.5 is the floor
     WCAG 1.4.8 sets for line spacing inside a BLOCK OF TEXT, and that is what
     stopped the body leading there earlier today. These are not blocks of
     text: a venue, a date, a rhythm -- one short line each, which wrap only
     on the longest venue name in the fixture. The criterion is about keeping
     a reader's eye on the right line through a paragraph, and a paragraph is
     the thing this is not.

     The title keeps --lh-card, which was always tighter than either.

     ...AND THE 12px UNDER THE TITLE GOES WITH IT. Leading is only half of
     what reads as space between lines; the other half was three margins, and
     on a phone they went to zero on 2026-10-23 while desktop kept 4/12/4.
     Same section, two spacings, for no reason other than which rule was
     edited. */
  .card-where { margin: 0; font-size: var(--t-body); line-height: var(--lh-h2); }
  .card-when, .card-who {
    margin: 0; font-size: var(--t-body); line-height: var(--lh-h2);
    color: var(--ink);
  }

  /* A LINE, not a section. These are established regulars with no date inside
     the window; they are here so their pages are reachable, not to be read. */
  .standing {
    margin: var(--space-32) 0 0; padding-top: var(--space-16);
    border-top: var(--rule-weight) solid var(--rule);
    font-size: var(--t-body); color: var(--ink);
  }
  .standing-label {
    text-transform: uppercase; letter-spacing: var(--tr-kicker);
    margin-right: var(--space-8);
  }
  /* On a phone the label and the link ran together into one wrapped sentence --
     "Aussi, régulièrement Milonga de la Vieille Ville chaque mois" across 76px
     and nine inline fragments, with tracked uppercase butting straight into a
     link. The label is a heading for the line, so on a narrow screen it gets
     its own. */
  @media (max-width: 40rem) {
    .standing-label { display: block; margin-right: 0; margin-bottom: var(--space-4); }
  }
  .standing a { color: var(--ink); }

  /* One column before the cards get too narrow to hold a 27px title. */
  @media (max-width: 48rem) {
    .cards { grid-template-columns: 1fr; gap: var(--space-32); }
  }
  /* ON A PHONE THE FLYER STOPS BEING A THUMBNAIL. The note that used to be
     here said a flyer is "the thing a reader recognises first" on a phone, and
     then gave it the smallest size it has anywhere -- 96px beside a text block
     that dominated it. Either the claim was wrong or the layout was; the claim
     is right, so the layout changes.

     THE SQUARE CROP GOES WITH IT, and that is the part that matters. The
     fixture's placeholders are 900x1200 because real flyers are portrait, so
     `aspect-ratio: 1` was already discarding a quarter of every one. At 96px
     nobody notices. At 343px it would cut the top and the bottom -- which on a
     flyer is the title and the date, the two things it exists to tell you. A
     hero that has had its headline cropped off is not a hero.

     The cost is honest: a 3:4 flyer at 343px wide is 457px tall, so a card
     with one is most of a screen. Two of the seventeen fixture events have a
     flyer and most real ones never will, so this is a tall exception rather
     than a tall list. If that ever stops being true, cap it with a
     max-height and accept cropping again -- but measure the ratio first.

     sizes/widths had to move with it: the old sizes said 34vw, which on a
     375px screen asks for a 127px file to put in a 343px box. */
  @media (max-width: 30rem) {
    .card.has-flyer { grid-template-columns: 1fr; gap: var(--space-12); }

    /* THE FLYER SITS BETWEEN THE KICKER AND THE TITLE, not above both. It was
       above the whole card first, which made the card open on an image with no
       word of context -- on a page of them you scroll past three pictures
       before learning what any of them is. The kicker first says what KIND of
       thing this is, then the flyer shows it, then the title names it.

       .card-text is a pure wrapper with no styles of its own: it exists only so
       the text is ONE grid item beside the media on wide screens. display:
       contents dissolves it here, so its children become grid items of the card
       itself and `order` can interleave the flyer among them. Safe on a plain
       div -- the accessibility bug that made display:contents risky applied to
       elements carrying an implicit ARIA role, like a list or a button.

       The children's own margins go with it. Spacing is the grid's gap now, and
       keeping both would have stacked one on the other. */
    .card.has-flyer .card-text { display: contents; }
    .card.has-flyer .type       { order: 1; }
    .card.has-flyer .card-media { order: 2; }
    .card.has-flyer h3          { order: 3; margin: 0; }
    .card.has-flyer .card-where { order: 4; }
    .card.has-flyer .card-when  { order: 5; margin-top: 0; }

    /* ONE GAP WAS DOING TWO JOBS. The 12px above separates the flyer from the
       words AND every line of text from the next, because `order` interleaves
       them as siblings of one grid. Tightening the lines to match a card
       without a flyer -- 4px -- would have pushed the image hard against the
       kicker above it and the title below; leaving it at 12 left this one
       card type visibly looser than every other listing on the page.

       So the gap goes to the text's spacing and the IMAGE buys its own air
       back with a margin. 4 + 8 lands the flyer 12px clear on both sides,
       exactly where it was, while the three text lines close up. Measured
       after: type-media 12, media-h3 12, h3-where 4, where-when 4. */
    .card.has-flyer { gap: var(--space-4); }
    .card.has-flyer .card-media { margin: var(--space-8) 0; }

    /* `height: auto` is NOT redundant here, and leaving it out cost a
       deadlock. The base rule sets width:100% with aspect-ratio:1, and that
       square ratio was quietly doing a second job: reserving the box before a
       lazy image arrives. Replacing it with `auto` alone computed height:0,
       so the intersection observer never fired, so the image never loaded, so
       naturalHeight stayed 0 and the height stayed 0 -- a permanently empty
       box, not a slow one. Measured: complete:false, naturalWidth:0 and an
       empty currentSrc after scrolling it into view and waiting.

       With height:auto the browser takes the ratio from the width/height
       attributes Astro emits (900x1200) before any byte is fetched, so the
       space is reserved, the observer fires, and the real ratio takes over on
       load. Verified cold, not after a style poke. */
    .card-media img { aspect-ratio: auto; height: auto; }
  }

  /* Three columns need the width. Below it the place goes under the title
     rather than beside it -- but the DATE COLUMN KEEPS ITS 20rem, and that is
     the part that was wrong until 2026-10-15. It was 15rem here while the date
     was still set at the desktop --t-h2, so at 768 and 900px every plain date
     in the fixture wrapped: a 240px column holding type that needs 315. The
     two-column row is narrower than the three-column one; the DATE is not. */
  @media (max-width: 62rem) {
    .events li { grid-template-columns: 20rem 1fr; }
    /* NOT A FLEX ROW -- AN ADDRESS IS A SENTENCE. It was `flex-direction: row`
       with a gap, which turns "7 place Garibaldi", "06300" and "Nice" into
       three shrinkable boxes. Flex items shrink before they wrap, so in this
       band -- where the column is 321px and the parts need 322 -- the browser
       squeezed the first box and broke the STREET NAME across two lines:

           7 place
           Garibaldi      06300   Nice

       The markup already writes it as prose: each part after the first carries
       its own leading space. Making the box a block lets the spans be inline
       text again, so it wraps at word boundaries like any sentence and the
       gap, which was doubling with those spaces, is no longer needed.

       Only this band was ever wrong. Above 62rem the column stacks the parts
       deliberately; below 40rem the row is full width and the address fits on
       one line either way. */
    .where { grid-column: 2; display: block; }
    /* ...and so is its wrapper, or the spans stay stacked inside a flex
       column that .where no longer controls. */
    .where .map, .where .map-off { display: inline; }
  }
  /* 96px between blocks is a desktop rhythm. On an 812px screen it put 190px
     of nothing between the lede and the first section heading -- most of a
     screenful, scrolled past before anything is read. */
  @media (max-width: 40rem) {
    .block { margin: var(--space-48) 0; }

    /* LESS LEADING EVERYWHERE ON A PHONE. Everything that inherits the body's
       --lh-body (1.6) gets --lh-meta (1.5) instead: the lede, the empty-state
       lines, the card fields, the regulars line and the archive link. The
       headings are not in the list because they were never loose -- h1 is at
       1.05, a section heading at 1.08, a card title at 1.25.

       1.6 is a measure-length decision. It was chosen for a 75rem shell where
       a paragraph runs long and the eye needs help finding the next line; a
       343px column does not, and the same ratio there just spreads the page
       out. */
    .empty, .standing, .more { line-height: var(--lh-meta); }

    /* THE LEDE NEEDS ITS OWN LEADING ONCE IT IS A HEADING'S SIZE, and the
       phone is where that bites. --lh-section is 1.03/1.08 because a section
       heading is one line, or two; at 375px this sentence wraps to SEVEN at
       31px, and a paragraph set solid collides its own ascenders with the
       descenders above them. --lh-h2 (1.25) is the step that reads as prose
       without going back to the 1.5 it had as body text.

       Desktop keeps --lh-section: at 48px in a 75rem column the same sentence
       is two lines, which is a heading's shape and takes a heading's
       leading. */
    .intro { line-height: var(--lh-h2); }

    /* A CARD IS AN EVENT TOO, so its fields take the same --t-meta as a row's.
       Two listings of the same thing on one page, one at 20px and one at 16,
       would read as an accident -- and on a phone the grid is a single column
       at the same 343px as a row, so they are literally side by side down the
       page.

       It also repairs something this session broke in passing: `.type` is one
       rule for both listings, so sending the row's eyebrow to --t-meta sent
       the card's with it, leaving a card whose label was SMALLER than the
       venue under it. Now the label and the fields agree again.

       The card TITLE keeps --t-card (27px) rather than joining the row's
       --t-h1 (31px). Those are two tuned triples -- size, leading, tracking --
       and the card's was measured against the reference's own Events section.
       Worth a second look: at one column they are the same object in two
       sizes. */
    .card-where, .card-when, .card-who { font-size: var(--t-meta); }

    /* AND THE CARD TITLE JOINS THE ROW TITLE, which closes the question left
       open above. --t-card (27px) was measured against the reference's Events
       section at a ~460px column; on a phone the grid is ONE column at 343px,
       the same width as a row, so the two listings are the same object
       stacked down one page and had no business being 27 and 31.

       All three of the triple move together -- size, leading and tracking --
       because --tr-card (-0.034em) was chosen for --t-card. Carrying a
       tracking value across to a different size is the mistake docs/DESIGN.md
       records as "taking a number without its role".

       SPACING TO MATCH TOO. Measured inside a card before this: 8px above the
       title, 12px below it, 4px before the date -- against a row, which is
       flush, every line separated by its own leading and nothing else. The
       title keeps the row's 4px either side; the rest goes to zero. */
    .card h3 {
      font-size: var(--t-h1); line-height: var(--lh-h1);
      letter-spacing: var(--tr-h1);
      margin: var(--space-4) 0;
    }

    /* A row title's line box is 27.5px and a card's 30px, so 10px either side
       takes them to 47.5 and 50. 8px was tried first and produced 43.5 -- half
       a pixel short, and invisible to a probe that rounds before comparing.
       See the touch-target note in base.css for why the margin cancels. */
    h3 a, .more a {
      display: inline-block;
      padding: 10px 0;
      margin: -10px 0;
    }
  }

  /* THE ROW STACKS AT 40rem, not 30rem, from 2026-10-15. Two columns need
     room for a 20rem date beside a title, and a 448px shell cannot give it:
     at 30rem the title column came out at 152px. 40rem is also where the type
     steps down, so the two changes now happen together instead of leaving a
     band with desktop-sized dates in a phone-sized layout. */
  @media (max-width: 40rem) {
    /* gap: 0, down from --space-4. Stacked, every field is its own grid item,
       so that gap was 4px of air ADDED to each line's own leading -- five
       items to a row, four gaps, 16px per row on top of the line boxes. With
       the row set at --lh-meta the leading already separates the lines, and
       what the gap separated was a column layout that no longer exists here.
       h3 keeps its own 4px margins, so the title still breathes. */
    .events li { grid-template-columns: 1fr; gap: 0; }
    .where { grid-column: auto; }

    /* THE EVENT PAGE'S SIZES, NOT JUST ITS FACES -- 2026-10-23, and it
       replaces the "one size across the stacked row" answer from earlier the
       same day. That one put everything at the title's size; this one puts
       the title at --t-h1 and everything else at --t-meta, which is exactly
       the two-step an event page has: one large thing, one size under it.

       The eyebrow goes to --t-meta with the rest rather than keeping
       --t-kicker. It was the smaller thing when the row was uniform; with the
       row at 16px, leaving it at 20 would have made the format label the
       second-largest text in the row. It is still marked -- uppercase, the
       accent, +0.09em -- which is how the same label works on an event page.

       A 31px title in a list of eight rows is a lot of title. That is the
       shape asked for, and it is also what makes the row scannable: the one
       thing a reader is looking for is the only thing set large. */
    h3 { font-size: var(--t-h1); line-height: var(--lh-h1); }
    /* --lh-h2 (1.25), matching the cards -- the two listings stack in ONE
       column on a phone, directly above one another, so 24px line boxes in a
       row against 20px in a card was visible as a mistake rather than as a
       distinction. Same reasoning as the cards: a date, an organizer and a
       venue are single short lines, not the block of text WCAG 1.4.8's 1.5
       floor is written for. The lede, the prose and the footer keep 1.5.

       .type is in this list, so BOTH eyebrows move -- the rule is shared
       between the row and the card, which is how the card's eyebrow came to
       be 16px in the first place. */
    .date, .time, .type, .meta, .where, .status {
      font-size: var(--t-meta); line-height: var(--lh-h2);
    }

    /* THE ROW GIVES UP ITS EQUAL WEIGHTS HERE, deliberately, and this reverses
       the rule three columns up. Across three columns, setting when/what/where
       at one size reads as three questions of equal rank on three axes. Once
       they stack into a single column that axis is gone, and three identical
       25px lines read as a flat list with nothing marking where a row starts.
       So on a phone the title keeps the heading size and everything else steps
       down to tokens that already exist: the thing being scanned for stays
       largest.

       WHEN and WHERE stay equal to each other -- that half of the desktop rule
       is sound and survives the stack. What gives way is the ORGANIZER, which
       was the same 18px as both and is the one field a reader does not need to
       decide whether to go. Venue under organizer, which is what a first pass
       at this produced, had "MJC Magnan" set smaller than "El Gato Tanguero"
       on a screen where the venue is the harder question. */
    /* ONE SIZE ACROSS THE STACKED ROW, bar the eyebrow -- asked for on
       2026-10-23, and it reverses the three paragraphs above rather than
       qualifying them. They are kept because the reasoning is still the
       reasoning, and because a reader who finds this block should see what it
       overturned: the claim was that three identical lines read as a flat
       list with nothing marking where a row starts. What marks it now is
       --type, which is the only thing that steps DOWN, plus the rule above
       every row and the accent the eyebrow carries.

       --t-kicker (20px) is already smaller than --t-h2 (24px here), so the
       eyebrow needs no rule of its own: the token that exists for it is
       the token that makes it the smaller thing. .date and .where need none
       either -- dropping their overrides returns them to the --t-h2 the
       three-column row sets, which is what the title is set at. */
    /* THE SAME FACES AS AN EVENT PAGE, asked for on 2026-10-23. That page
       sets its title in the display face and every fact under it in the body
       face at normal tracking; here the date and the place were the odd ones
       out, set in Space Grotesk at --tr-h2 like the title they sit under.

       So they join the time and the organizer, which were already body type,
       and the row ends up with exactly the event page's split: Space Grotesk
       for the title and the eyebrow, IBM Plex for everything that answers
       when, who and where. Nothing here changes a SIZE -- the row is one size
       at every width now, three rules up.

       --weight rather than --weight-medium: both are 500, and this is the
       name the event page uses for the same job. */
    .date, .where {
      font-family: var(--font-body); font-weight: var(--weight);
      letter-spacing: normal;
    }
    /* Not a flex row. A date range wraps to two lines on a phone, and as a
       flex item the time was then stranded at the top right of the wrapped
       date instead of following it. As inline text it simply flows after. */
    .when { display: block; }
    .time { margin-left: var(--space-8); }
  }
</style>
