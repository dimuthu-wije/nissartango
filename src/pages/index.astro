---
import Layout from '../layouts/Layout.astro';
import { loadAgenda, TYPE_LABELS, priceSummary, fmtDay, fmtTime } from '../lib/content';

const { occurrences, organizers } = await loadAgenda();

// A cancelled series keeps its page but leaves the listing. A cancelled
// OCCURRENCE stays, struck through, with its reason: "pas de practica le
// 15 août" tells a reader something; a silently missing Tuesday does not.
const rows = occurrences.filter((o) => !o.event.cancelled_at);
---

<Layout title="Nissartango — Agenda du tango à Nice">
  <h1>Agenda</h1>
  <p class="intro">Cours, practicas, milongas et stages à Nice et sur la Côte d'Azur.</p>

  {rows.length === 0 && <p class="empty">Aucun événement à venir pour le moment.</p>}

  <ul class="events">
    {rows.map((o) => {
      const e = o.event;
      const organizer = organizers.get(e.organizer_id);
      const price = priceSummary(e);
      return (
        <li class={o.cancelled ? 'cancelled' : undefined}
            data-event={e.slug} data-date={o.dateKey}>
          <div class="when">
            <span class="date">{fmtDay(o.start, e.timezone)}</span>
            <span class="time">{fmtTime(o.start, e.timezone)}</span>
          </div>
          <div class="what">
            <span class="type">{TYPE_LABELS[e.type] ?? e.type}</span>
            <h2><a href={`/evenements/${e.slug}/`}>{e.title}</a></h2>
            <p class="meta">
              {e.location_name}{e.location_name && ', '}{e.city}
              {price && <> · {price}</>}
              {organizer && <> · {organizer.name}</>}
            </p>
            {o.cancelled && (
              <p class="off">Annulé{o.note ? ` — ${o.note}` : ''}</p>
            )}
            {o.moved && <p class="off moved">Séance déplacée{o.note ? ` — ${o.note}` : ''}</p>}
          </div>
        </li>
      );
    })}
  </ul>
</Layout>

<style>
  h1 { font-size: 1.9rem; margin: 2rem 0 0.25rem; letter-spacing: -0.02em; }
  .intro { color: var(--muted); margin: 0 0 2rem; }
  .empty { color: var(--muted); }
  .events { list-style: none; padding: 0; margin: 0; }
  .events li {
    display: grid; grid-template-columns: 8.5rem 1fr; gap: 1rem;
    padding: 1.1rem 0; border-top: 1px solid var(--line);
  }
  .when { display: flex; flex-direction: column; }
  .date { font-size: 0.9rem; text-transform: capitalize; }
  .time { color: var(--muted); font-size: 0.85rem; }
  .type {
    font-size: 0.7rem; text-transform: uppercase; letter-spacing: 0.08em;
    color: var(--accent); font-weight: 600;
  }
  h2 { font-size: 1.05rem; margin: 0.15rem 0 0.3rem; }
  h2 a { color: inherit; text-decoration: none; }
  h2 a:hover { text-decoration: underline; }
  .meta { margin: 0; color: var(--muted); font-size: 0.88rem; }
  .off { margin: 0.35rem 0 0; font-size: 0.85rem; font-weight: 600; color: #b3261e; }
  .off.moved { color: var(--muted); }
  li.cancelled .date, li.cancelled h2 { text-decoration: line-through; }
  li.cancelled { opacity: 0.75; }
  @media (max-width: 30rem) {
    .events li { grid-template-columns: 1fr; gap: 0.25rem; }
    .when { flex-direction: row; gap: 0.5rem; }
  }
</style>
