# build output
dist/

# generated types
.astro/

# wrangler's local state, and the deploy-config redirect the Astro Cloudflare
# adapter used to write. That redirect pointed at dist/client/wrangler.json,
# which no longer exists now the site is adapter-free -- and because it was
# committed, it followed the repo to Cloudflare and failed every deploy.
.wrangler/

# dependencies
node_modules/

# logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# environment variables
.env
.env.production

# macOS-specific files
.DS_Store

# jetbrains setting folder
.idea/

# supabase CLI working files (config.toml and migrations ARE committed)
supabase/.branches/
supabase/.temp/

# Event images are pulled from Supabase Storage on every build; Storage is
# their source of truth. Delete these two lines if you would rather have the
# flyers backed up in git alongside data/snapshot.json.
src/assets/events/*
!src/assets/events/.gitkeep
