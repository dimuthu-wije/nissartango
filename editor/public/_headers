# Headers for the editor origin. This deployment receives an access token in a
# URL fragment, so it gets a stricter policy than the public site.
#
# Cloudflare serves this file as configuration, not as content.

/*
  # No inline script anywhere in this deployment -- both pages load
  # /session.js as a module -- so the policy can forbid inline script outright
  # rather than carry 'unsafe-inline' or a hash that drifts out of date.
  #
  # connect-src NAMES ONE ORIGIN. It said 'self' until 2026-09-19, when the
  # sign-in form started calling /auth/v1/otp and /auth/v1/token -- so this is
  # the visible edit the earlier comment asked for, rather than a wildcard
  # added in advance.
  #
  # ONE project ref, spelled out. Not https://*.supabase.co, which would let a
  # compromised script post an access token to any project on the platform.
  # eqcgeqzzuzcwrflwasjo is PRODUCTION; the names are backwards, so read the
  # ref (supabase/PROJECT_SETUP.md).
  #
  # form-action stays 'none' deliberately even though there is now a form: it
  # is submitted by fetch(), never by the browser navigating, so nothing should
  # be able to POST this page anywhere.
  Content-Security-Policy: default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' https://eqcgeqzzuzcwrflwasjo.supabase.co; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  # frame-ancestors above already covers this for modern browsers; kept for the
  # ones that only honour the header.
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Cross-Origin-Opener-Policy: same-origin
  # This origin should never have been reachable over plain HTTP, but say so.
  Strict-Transport-Security: max-age=31536000; includeSubDomains

/auth/callback
  # The URL that carries the token. Never let an intermediary keep a copy of
  # the response, and never let a bfcache restore repaint a page whose
  # fragment has already been cleared.
  Cache-Control: no-store, must-revalidate

/auth/callback/
  Cache-Control: no-store, must-revalidate
