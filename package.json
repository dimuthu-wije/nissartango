{
  "name": "nissartango",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "prepare": "git config core.hooksPath .githooks 2>/dev/null || true",
    "dev": "node scripts/fetch-content.mjs && astro dev",
    "build": "node scripts/fetch-content.mjs && astro build",
    "build:snapshot": "node scripts/fetch-content.mjs --from-snapshot && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "TZ=UTC node --test tests/*.test.js workers/*/test/*.test.js",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run build && npm run verify:build && npm run check:db",
    "check:db": "bash scripts/check-db.sh",
    "deploy:cron": "node scripts/check-cron-config.mjs && wrangler deploy --config workers/cron/wrangler.jsonc",
    "seed:real": "bash scripts/seed-real.sh",
    "hooks:install": "git config core.hooksPath .githooks && echo \"hooks: core.hooksPath -> .githooks\"",
    "deploy:notifier": "wrangler deploy --config workers/build-notifier/wrangler.jsonc",
    "deploy:editor": "wrangler deploy --config editor/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "astro": "^7.2.4",
    "wrangler": "^4.125.0"
  }
}
