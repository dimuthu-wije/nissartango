{
  "name": "nissartango",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "node scripts/fetch-content.mjs && astro dev",
    "build": "node scripts/fetch-content.mjs && astro build",
    "build:snapshot": "node scripts/fetch-content.mjs --from-snapshot && astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "TZ=UTC node --test tests/*.test.js workers/cron/test/*.test.js",
    "verify:build": "node scripts/verify-build.mjs",
    "check": "npm run build && npm run verify:build",
    "deploy:cron": "wrangler deploy --config workers/cron/wrangler.jsonc"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.2.3",
    "astro": "^7.2.4",
    "wrangler": "^4.125.0"
  }
}